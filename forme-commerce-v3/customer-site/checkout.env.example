# Server-only Netlify environment variables. Do not commit actual values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORE_ORIGIN=https://YOUR-SHOP.netlify.app
MANAGEMENT_ORIGIN=https://YOUR-MANAGEMENT.netlify.app
# Email alerts for account edits and shipment updates. Verify MAIL_FROM domain.
RESEND_API_KEY=
MAIL_FROM="FORME <orders@your-domain.com>"
# Stripe: only use a merchant account available in your business's country.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# QPay: MNT, with merchant credentials supplied by QPay.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_SECRET=
